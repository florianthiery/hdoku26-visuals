ci:cisite_45 a fsl:Site,
        geolod:CIArchaeologicalSite,
        geolod:CIFindspot,
        <http://www.cidoc-crm.org/extensions/crmarchaeo/A2_Stratigraphic_Volume_Unit>,
        prov:Entity,
        pleiades:Place ;
    rdfs:label "Franchthi Cave (Greece)"@en ;
    dct:creator <https://orcid.org/0000-0002-3246-3531>,
        <https://orcid.org/0000-0003-1100-6494> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:rightsHolder <https://orcid.org/0000-0002-3246-3531>,
        <https://orcid.org/0000-0003-1100-6494> ;
    geolod:hasCertaintyDescription "findspot mentioned in a scientific paper and found on OpenStreetMap"@en ;
    geolod:hasCertaintyLevel fsl:high ;
    geolod:hasLiteratureReference "Fedele et al., 2003" ;
    geolod:hasSpatialType fsl:ArchaeologicalSite,
        fsl:Cave ;
    geo:hasGeometry ci:cisite_45_geom ;
    rdfs:comment "CI findspot related from literature"@en ;
    skos:closeMatch <http://openstreetmap.org/node/1221172611>,
        <http://wikidata.org/entity/Q1441331> ;
    skos:prefLabel "Franchthi Cave (Greece)"@en ;
    skos:scopeNote "CI findspot related from literature"@en ;
    prov:wasAttributedTo <http://orcid.org/0000-0002-3246-3531>,
        <https://github.com/Research-Squirrel-Engineers/campanian-ignimbrite-geo/blob/main/py/CI.py> ;
    prov:wasDerivedFrom <https://github.com/Research-Squirrel-Engineers/campanian-ignimbrite-geo> ;
    prov:wasGeneratedBy ci:cisite_45_pyscript .

