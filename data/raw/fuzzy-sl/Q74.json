wikibase-entityid"},"datatype":"wikibase-item"}],"P6":[{"snaktype":"value","property":"P6","hash":"7c5d62352af1c679c62690a2f65b0ed3260c3b82","datavalue":{"value":{"entity-type":"item","numeric-id":78,"id":"Q78"},"type":"wikibase-entityid"},"datatype":"wikibase-item"}],"P15":[{"snaktype":"value","property":"P15","hash":"ac73067930fb968ec5a97955beec306101c2446c","datavalue":{"value":"on-site survey at UCC Cork","type":"string"},"datatype":"string"}],"P23":[{"snaktype":"value","property":"P23","hash":"b244f7450ca309b1cf6aec97c5286395e671d728","datavalue":{"value":"\u00b10.0001\u00b0","type":"string"},"datatype":"string"}],"P24":[{"snaktype":"value","property":"P24","hash":"d137c87bc86fdc1d99f20355acc3fff5de653f35","datavalue":{"value":{"entity-type":"item","numeric-id":132,"id":"Q132"},"type":"wikibase-entityid"},"datatype":"wikibase-item"}],"P33":[{"snaktype":"value","property":"P33","hash":"08ec91f49848d4fd93a6e5880c7282a5e1f35497","datavalue":{"value":{"entity-type":"item","numeric-id":133,"id":"Q133"},"type":"wikibase-entityid"},"datatype":"wikibase-item"}]},"qualifiers-order":["P5","P13","P7","P14","P16","P6","P15","P23","P24","P33"],"id":"Q74$044fd031-4b81-05b3-c118-c7f409417337","rank":"preferred"},{"mainsnak":{"snaktype":"value","property":"P4","hash":"a1837719bd58508edec861bf304b735bea9daf45","datavalue":{"value":{"latitude":51.81655,"longitude":-8.765869444444444,"altitude":null,"precision":2.777777777777778e-6,"globe":"http://www.wikidata.org/entity/Q2"},"type":"globecoordinate"},"datatype":"globe-coordinate"},"type":"statement","qualifiers":{"P5":[{"snaktype":"value","property":"P5","hash":"4cd26ba769bf361fc9b3980822ad39cac1a8b08f","datavalue":{"value":{"entity-type":"item","numeric-id":24,"id":"Q24"},"type":"wikibase-entityid"},"datatype":"wikibase-item"}],"P13":[{"snaktype":"value","property":"P13","hash":"aa034734272d0add6616fb792394f9537cba5511","datavalue":{"value":"Gippert/Web, Ogham 81: `According to Brash, JRSAI 10, 1869, 260, the stone was found in a structure called Rath Lisheenagreine, in the townland of Gurranes (sic!), parish of Templemartin, 1 mle. north of the parish church (the village in question is named \"Gurranes\" in the Cork U.C. too). A detailed map of the rath (in connection with the larger Rath Lisnacaheragh) is available in S.P. O' R\u040eord\u044fin's article in PRIA 47-C, 1941-42, 77 ff. - According to Brash, the stone was discovered by one farmer Crowley 17 years before (the publication of his article in JRSAI 10, 1869); Macalister states in CIIC that it \"has been known since the sixities\" and \"appears to have come from a souterrain in the group\" of \"earth-works\" on the townland of Gurranes. The first report was made by John Lyons, C.C., Newcestown, Enniskeane; Brash's visit took place on 16.12.1868. The stone was moved to the Museum of the U.C., Cork after Macalister first visited it (at that time it was still \"standing loosely in one of the ditches\": CIIC 1, 84). In the collection of the U.C., it is assigned no. 17.'.","type":"string"},"datatype":"string"}],"P7":[{"snaktype":"value","property":"P7","hash":"9bd2c45f902cc46626138fed5415ba12d21e9c0f","datavalue":{"value":{"entity-type":"item","numeric-id":17,"id":"Q17"},"type":"wikibase-entityid"},"datatype":"wikibase-item"}],"P14":[{"snaktype":"value","property":"P14","hash":"5d80a1ae7a97d6c27a8919614daa22505139b62e","datavalue":{"value":{"entity-type":"item","numeric-id":35,"id":"Q35"},"type":"wikibase-entityid"},"datatype":"wikibase-item"}],"P6":[{"snaktype":"value","property":"P6","hash":"4b0b69cce1ef7d94360781da603bbb9053096cef","datavalue":{"value":{"entity-type":"item","numeric-id":20,"id":"Q20"},"type":"wikibase-entityid"},"datatype":"wikibase-item"}],"P16":[{"snaktype":"value","property":"P16","hash":"326e561b18c1ef4d9c35a223211d5c58b950ba6a","datavalue":{"value":{"entity-type":"item","numeric-id":19,"id":"Q19"},"type":"wikibase-entityid"},"datatype":"wikibase-item"}],"P15":[{"snaktype":"value","property":"P15","hash":"e060